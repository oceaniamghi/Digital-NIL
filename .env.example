PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
# Comma-separated allowed CORS origins. Leave blank to allow all (same-origin app).
CORS_ORIGIN=

# MongoDB — REQUIRED in production. Use a real MongoDB Atlas connection string.
# In production the app refuses the in-memory fallback and retries until this is
# reachable, so customer data is never silently lost.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digitalni

# JWT — REQUIRED in production. Generate a strong value: openssl rand -hex 48
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── Vendor licensing / remote kill switch ─────────────────────────────────────
# Secret that ONLY YOU (the vendor) hold. Enables the owner control API to
# lock/unlock the deployment remotely and set the paid-through date. Without it,
# remote controls are disabled. Generate: openssl rand -hex 32
#   Lock:    curl -X POST $URL/api/owner/lock        -H "x-owner-key: $OWNER_KEY" -H "Content-Type: application/json" -d '{"reason":"Non-payment"}'
#   Unlock:  curl -X POST $URL/api/owner/unlock      -H "x-owner-key: $OWNER_KEY"
#   Extend:  curl -X POST $URL/api/owner/paid-through -H "x-owner-key: $OWNER_KEY" -H "Content-Type: application/json" -d '{"date":"2026-12-31"}'
#   Status:  curl $URL/api/owner/status              -H "x-owner-key: $OWNER_KEY"
# Or from the Railway shell: npm run license -- lock "reason" | unlock | status | paid-through 2026-12-31 | seat-limit 30
OWNER_KEY=
# Nuclear hard-kill: set to true in Railway env and redeploy to instantly lock the
# app regardless of DB state. The customer's own admins can NEVER override this.
APP_DISABLED=false
# Optional fallback paid-through date (ISO). The DB value set via the owner API wins.
# PAID_THROUGH=2026-12-31
# Max billable staff seats (real logins; brands/sponsors and roster athletes excluded).
SEAT_LIMIT=50

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Digital NIL <noreply@digitalni.com>

# File Uploads — on Railway, mount a persistent Volume and point UPLOAD_DIR at it
# (e.g. /data/uploads) so uploaded content survives redeploys. Local ./uploads is
# wiped on every deploy.
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# YouTube Data API key — used for highlight reel embeds. Get one at https://console.cloud.google.com/apis/credentials

YOUTUBE_API_KEY=your-youtube-api-key

# Live social follower counts (Instagram / X / TikTok) via RapidAPI scrapers.
# Subscribe to one scraper product per platform on rapidapi.com, then put the
# single shared key here. Optionally override the default hosts if you pick
# different products. Counts are cached server-side (default 12h).
RAPIDAPI_KEY=your-rapidapi-key
# RAPIDAPI_INSTAGRAM_HOST=instagram-scraper-api2.p.rapidapi.com
# RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com
# RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
# SOCIAL_CACHE_HOURS=12

# CRM outbound email via Resend (optional). Without a key, outreach emails are
# logged to the record timeline but not sent; add a key to start sending.
# Get one at https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=AiC NIL <onboarding@resend.dev>